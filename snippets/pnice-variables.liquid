{%- comment -%}
  P-nice luxury skincare brand tokens.
  Loads Cormorant Garamond + Jost from Google Fonts and exposes
  --pnice-* CSS variables consumed by all pnice-* sections.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap"
>

{% style %}
  :root {
    --pnice-sage: #4a6741;
    --pnice-sage-deep: #3a4d33;
    --pnice-sage-soft: #6f8463;
    --pnice-cream: #f5f0ea;
    --pnice-cream-deep: #ece3d7;
    --pnice-paper: #faf7f1;
    --pnice-ink: #2c2e29;
    --pnice-ink-soft: #5d6258;
    --pnice-gold: #b0893f;
    --pnice-gold-soft: #c8a460;
    --pnice-line: #e3dccf;
    --pnice-serif: 'Cormorant Garamond', Georgia, serif;
    --pnice-sans: 'Jost', system-ui, sans-serif;
  }

  .pnice-hero-wrapper,
  .pnice-categories-wrapper,
  .pnice-loyalty-wrapper,
  .pnice-bestsellers-wrapper,
  .pnice-formula-wrapper,
  .pnice-reviews-wrapper,
  .pnice-news-wrapper,
  .pnice-reassure-wrapper,
  .pnice-announce-wrapper {
    font-family: var(--pnice-sans);
  }

  .pnice-eyebrow,
  .pnice-eyebrow--gold {
    font-family: var(--pnice-sans);
  }

  .pnice-wrap {
    width: 100%;
    max-width: var(--page-width, 1280px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 40px);
    box-sizing: border-box;
  }

  /* Cross-site polish */
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .pnice-hero-wrapper *,
    .pnice-categories-wrapper *,
    .pnice-loyalty-wrapper *,
    .pnice-bestsellers-wrapper *,
    .pnice-formula-wrapper *,
    .pnice-reviews-wrapper *,
    .pnice-news-wrapper *,
    .pnice-reassure-wrapper *,
    .pnice-announce-wrapper *,
    .pnice-press-wrapper *,
    .pnice-concerns-wrapper *,
    .pnice-journal-wrapper *,
    .pnice-promise-wrapper *,
    .pnice-pdp-wrapper * {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
  }
  :is(
    .pnice-hero-wrapper,
    .pnice-categories-wrapper,
    .pnice-loyalty-wrapper,
    .pnice-bestsellers-wrapper,
    .pnice-formula-wrapper,
    .pnice-reviews-wrapper,
    .pnice-news-wrapper,
    .pnice-press-wrapper,
    .pnice-concerns-wrapper,
    .pnice-journal-wrapper,
    .pnice-promise-wrapper,
    .pnice-pdp-wrapper
  ) a:focus-visible,
  :is(
    .pnice-hero-wrapper,
    .pnice-categories-wrapper,
    .pnice-loyalty-wrapper,
    .pnice-bestsellers-wrapper,
    .pnice-formula-wrapper,
    .pnice-reviews-wrapper,
    .pnice-news-wrapper,
    .pnice-press-wrapper,
    .pnice-concerns-wrapper,
    .pnice-journal-wrapper,
    .pnice-promise-wrapper,
    .pnice-pdp-wrapper
  ) button:focus-visible {
    outline: 2px solid var(--pnice-sage, #4a6741);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .pnice-hero__title,
  .pnice-sec__title,
  .pnice-loy-card__title,
  .pnice-formula__title,
  .pnice-reviews__title,
  .pnice-news__title,
  .pnice-card h3,
  .pnice-loy-col h3,
  .pnice-cat__body h3,
  .pnice-rev__q,
  .pnice-ing__k,
  .pnice-card__price,
  .pnice-rev__av,
  .pnice-hero__stamp b {
    font-family: var(--pnice-serif);
  }
{% endstyle %}
