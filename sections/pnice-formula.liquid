{%- comment -%} P-nice ingredient / science formula section {%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="pnice-sec pnice-formula color-{{ section.settings.color_scheme }}">
  <div class="pnice-wrap pnice-formula__wrap">
    <div class="pnice-formula__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pnice-eyebrow pnice-eyebrow--gold">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pnice-formula__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.lead != blank -%}
        <p class="pnice-formula__lead">{{ section.settings.lead }}</p>
      {%- endif -%}
      <div class="pnice-ing-list">
        {%- for block in section.blocks -%}
          <div class="pnice-ing" {{ block.shopify_attributes }}>
            <div class="pnice-ing__k">{{ block.settings.name }}</div>
            <div class="pnice-ing__v">{{ block.settings.description }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="pnice-formula__art">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag:
          widths: '400, 600, 900',
          sizes: '(min-width: 880px) 50vw, 90vw',
          loading: 'lazy',
          alt: section.settings.image.alt | default: section.settings.heading
        }}
      {%- elsif section.settings.fallback_asset != blank -%}
        <img src="{{ section.settings.fallback_asset | asset_url }}" alt="Collagen, hyaluronic acid, aloe vera, avocado oil, lavender oil, and melatonin skincare ingredients" loading="lazy" width="900" height="900">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'pnice-formula__art-placeholder' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pnice-formula {
    background: var(--pnice-sage-deep, #3a4d33);
    color: #eef1ea;
    overflow: hidden;
  }
  .pnice-formula__wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .pnice-formula__title {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(34px, 4vw, 52px);
    color: #fff;
    margin: 16px 0 22px;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .pnice-formula__lead {
    color: #c7d0bf;
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 34px;
    max-width: 430px;
    font-family: var(--font-body--family);
  }
  .pnice-ing-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    max-width: 440px;
    font-family: var(--font-body--family);
  }
  .pnice-ing {
    display: flex;
    gap: 18px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    align-items: flex-start;
  }
  .pnice-ing__k {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: 22px;
    color: var(--pnice-gold-soft, #c8a460);
    width: 130px;
    flex-shrink: 0;
    line-height: 1.2;
    font-weight: 500;
  }
  .pnice-ing__v {
    font-size: 14px;
    color: #cdd6c5;
    line-height: 1.6;
  }
  .pnice-formula__art {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    background: #f1ede4;
  }
  .pnice-formula__art img,
  .pnice-formula__art-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 880px) {
    .pnice-formula__wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .pnice-formula__art {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Formula",
  "tag": "section",
  "class": "section-wrapper pnice-formula-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Melatonin" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "An antioxidant ingredient that helps support skin's natural overnight renewal and a refreshed-looking complexion by morning." }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the formula" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Inside the formula." },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "We pair thoughtfully-selected actives with calming botanicals so every ingredient earns its place — refined, restrained, and made for sensitive skin." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename (e.g. pnice-infographic.jpg)" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "P-nice Formula",
      "category": "P-nice",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Melatonin", "description": "An antioxidant ingredient that helps support skin's natural overnight renewal and a refreshed-looking complexion by morning." } },
        { "type": "ingredient", "settings": { "name": "Hyaluronic Acid", "description": "A humectant that helps the skin feel deeply hydrated and look plump and refreshed." } },
        { "type": "ingredient", "settings": { "name": "Hexapeptide-11", "description": "A peptide that helps skin look firmer and more refined over time." } },
        { "type": "ingredient", "settings": { "name": "Bisabolol", "description": "A soothing botanical that helps skin feel calm and comfortable alongside active ingredients." } }
      ]
    }
  ]
}
{% endschema %}
