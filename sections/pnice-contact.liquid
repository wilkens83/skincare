{%- comment -%}
  P-nice Contact section
  ---------------------------------------------
  Visible support address, email, phone, hours,
  and a working contact form using Shopify's
  built-in {%- form 'contact' -%} (no app required).
  Submissions go to the shop owner email by default;
  override via Settings → Notifications → Contact form.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section id="contact" class="pnice-contact color-{{ section.settings.color_scheme }}">
  <div class="pnice-wrap pnice-contact__grid">
    <div class="pnice-contact__info">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pnice-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="pnice-contact__title">{{ section.settings.heading | default: 'Contact P-nice' }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="pnice-contact__intro">{{ section.settings.intro }}</p>
      {%- endif -%}

      <ul class="pnice-contact__list">
        <li>
          <span class="pnice-contact__label">Email</span>
          <a href="mailto:support@p-nice.com">support@p-nice.com</a>
        </li>
        <li>
          <span class="pnice-contact__label">Phone</span>
          <a href="tel:+16165201895">616-520-1895</a>
        </li>
        <li>
          <span class="pnice-contact__label">Hours</span>
          <span>Monday – Friday, 9 am – 5 pm ET</span>
        </li>
        <li>
          <span class="pnice-contact__label">Mailing address</span>
          <address>
            P-nice<br>
            3008 Woodbridge Dr SE<br>
            Grand Rapids, Michigan<br>
            United States
          </address>
        </li>
        <li>
          <span class="pnice-contact__label">Website</span>
          <a href="https://p-nice.com">p-nice.com</a>
        </li>
      </ul>
    </div>

    <div class="pnice-contact__form-wrap">
      <h2>Send us a message</h2>
      {%- form 'contact', class: 'pnice-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="pnice-contact__success">Thanks — we've received your message and will reply within one business day.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <ul class="pnice-contact__errors">
            {%- for field in form.errors -%}
              <li>{{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <label>
          Name
          <input type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
        </label>
        <label>
          Email
          <input type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
        </label>
        <label>
          Subject
          <input type="text" name="contact[subject]" value="{% if form.subject %}{{ form.subject }}{% endif %}">
        </label>
        <label>
          Message
          <textarea name="contact[body]" rows="6" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </label>
        <button type="submit" class="pnice-contact__btn">Send Message</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pnice-contact {
    font-family: var(--font-body--family);
    padding-block: clamp(40px, 6vw, 80px);
  }
  .pnice-contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 880px) {
    .pnice-contact__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 60px;
      align-items: flex-start;
    }
  }
  .pnice-contact__title {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-foreground-heading);
    margin: 12px 0 16px;
  }
  .pnice-contact__intro {
    color: var(--color-foreground);
    opacity: 0.78;
    font-size: 15.5px;
    line-height: 1.65;
    margin-bottom: 28px;
  }
  .pnice-contact__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--pnice-line, #e3dccf);
  }
  .pnice-contact__list li {
    padding: 14px 0;
    border-bottom: 1px solid var(--pnice-line, #e3dccf);
    display: flex;
    gap: 16px;
    align-items: flex-start;
    font-size: 14.5px;
  }
  .pnice-contact__label {
    flex: 0 0 130px;
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pnice-gold, #b0893f);
    font-weight: 500;
    padding-top: 2px;
  }
  .pnice-contact__list a { color: var(--pnice-sage, #4a6741); text-decoration: underline; }
  .pnice-contact__list address { font-style: normal; line-height: 1.6; }
  .pnice-contact__form-wrap h2 {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 28px;
    font-weight: 500;
    color: var(--color-foreground-heading);
    margin-bottom: 16px;
  }
  .pnice-contact__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--pnice-paper, #faf7f1);
    padding: 24px;
    border: 1px solid var(--pnice-line, #e3dccf);
    border-radius: 6px;
  }
  .pnice-contact__form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--color-foreground);
  }
  .pnice-contact__form input,
  .pnice-contact__form textarea {
    border: 1px solid var(--pnice-line, #e3dccf);
    background: #fff;
    border-radius: 3px;
    padding: 12px 14px;
    font-family: inherit;
    font-size: 14px;
    color: var(--color-foreground);
  }
  .pnice-contact__form input:focus,
  .pnice-contact__form textarea:focus { outline: none; border-color: var(--pnice-sage, #4a6741); }
  .pnice-contact__btn {
    background: var(--pnice-sage, #4a6741);
    color: #fff;
    border: 0;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 14px;
    border-radius: 2px;
    cursor: pointer;
    margin-top: 6px;
  }
  .pnice-contact__btn:hover { background: var(--pnice-sage-deep, #3a4d33); }
  .pnice-contact__success { color: var(--pnice-sage, #4a6741); margin-bottom: 8px; }
  .pnice-contact__errors { color: #b34d4d; padding-left: 18px; margin-bottom: 8px; }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Contact",
  "tag": "section",
  "class": "section-wrapper pnice-contact-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer Care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact P-nice" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Questions about an order, an ingredient, or your routine? We're here. Reach us by email, phone, or the form — we usually respond within one business day." },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "P-nice Contact",
      "category": "P-nice"
    }
  ]
}
{% endschema %}
