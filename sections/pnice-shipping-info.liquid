{%- comment -%}
  P-nice Shipping Info section
  -----------------------------------------------------------------
  Standalone shipping page section. Useful when /policies/shipping-policy
  (Shopify's auto-generated policy URL) hasn't been published yet —
  this section renders a complete, Stripe-acceptable shipping page
  with default content the merchant can edit through the editor.

  IMPORTANT: this is not a legal substitute for the Shopify policy
  text set in Settings → Policies. Once that's published, link to
  it from the policy bar; keep this page as the customer-facing
  details page.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section id="shipping" class="pnice-shipping color-{{ section.settings.color_scheme }}">
  <div class="pnice-wrap pnice-shipping__wrap">
    <header class="pnice-shipping__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pnice-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="pnice-shipping__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="pnice-shipping__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    <div class="pnice-shipping__body">
      <div class="pnice-shipping__table">
        <h2>Rates &amp; delivery times (United States)</h2>
        <table>
          <thead>
            <tr><th>Method</th><th>Delivery</th><th>Cost</th></tr>
          </thead>
          <tbody>
            <tr><td>Standard (orders $60+)</td><td>3–7 business days</td><td>Free</td></tr>
            <tr><td>Standard (orders under $60)</td><td>3–7 business days</td><td>$5.95</td></tr>
            <tr><td>Expedited</td><td>2–3 business days</td><td>$12.95</td></tr>
            <tr><td>Overnight</td><td>1 business day</td><td>$24.95</td></tr>
          </tbody>
        </table>
        <p class="pnice-shipping__note">Delivery estimates are calculated from the date your order ships, not the date you place the order.</p>
      </div>

      {%- for block in section.blocks -%}
        <section class="pnice-shipping__block" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h2>{{ block.settings.title }}</h2>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="rte">{{ block.settings.body }}</div>
          {%- endif -%}
        </section>
      {%- endfor -%}

      <section class="pnice-shipping__contact">
        <h2>Questions about your order?</h2>
        <p>Reach our team — we usually reply within one business day.</p>
        <ul>
          <li>Email: <a href="mailto:support@p-nice.com">support@p-nice.com</a></li>
          <li>Phone: <a href="tel:+16165201895">616-520-1895</a> (Mon–Fri, 9 am–5 pm ET)</li>
          <li>Mail: P-nice, 3008 Woodbridge Dr SE, Grand Rapids, MI</li>
        </ul>
      </section>
    </div>
  </div>
</section>

{% stylesheet %}
  .pnice-shipping {
    font-family: var(--font-body--family);
    padding-block: clamp(40px, 6vw, 80px);
  }
  .pnice-shipping__head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 44px;
  }
  .pnice-shipping__title {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-foreground-heading);
    margin: 12px 0 16px;
  }
  .pnice-shipping__intro {
    color: var(--color-foreground);
    opacity: 0.78;
    font-size: 16px;
    line-height: 1.65;
  }
  .pnice-shipping__body {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .pnice-shipping__body h2 {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 26px;
    font-weight: 500;
    color: var(--color-foreground-heading);
    margin-bottom: 14px;
  }
  .pnice-shipping__body .rte p,
  .pnice-shipping__contact p { margin-bottom: 12px; line-height: 1.7; }
  .pnice-shipping__table table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 12px;
    font-size: 14.5px;
  }
  .pnice-shipping__table th,
  .pnice-shipping__table td {
    text-align: left;
    padding: 12px 14px;
    border-bottom: 1px solid var(--pnice-line, #e3dccf);
  }
  .pnice-shipping__table th {
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-foreground-heading);
    background: var(--pnice-paper, #faf7f1);
  }
  .pnice-shipping__note { font-size: 13px; color: var(--color-foreground); opacity: 0.7; }
  .pnice-shipping__contact ul { list-style: none; padding: 0; }
  .pnice-shipping__contact li { padding: 4px 0; }
  .pnice-shipping__contact a,
  .pnice-shipping__body a { color: var(--pnice-sage, #4a6741); text-decoration: underline; }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Shipping Info",
  "tag": "section",
  "class": "section-wrapper pnice-shipping-wrapper",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "info_block",
      "name": "Info block",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Section title" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Section content here.</p>" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer Info" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping &amp; Delivery" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Everything you need to know about how we ship your P-nice order — rates, delivery times, tracking, and what to do if something goes wrong." },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "P-nice Shipping Info",
      "category": "P-nice",
      "blocks": [
        { "type": "info_block", "settings": {
          "title": "Order processing",
          "body": "<p>Orders placed Monday through Friday before 12 pm ET ship the same business day. Orders placed after 12 pm ET, on weekends, or on US holidays ship the next business day. You'll get an email with tracking as soon as your label is created.</p>"
        }},
        { "type": "info_block", "settings": {
          "title": "Tracking your order",
          "body": "<p>Every order includes a tracking link in your shipping confirmation email. If you don't see it in your inbox within 2 business days of ordering, check your spam folder, then email us at <a href=\"mailto:support@p-nice.com\">support@p-nice.com</a> — we'll re-send your tracking right away.</p>"
        }},
        { "type": "info_block", "settings": {
          "title": "International shipping",
          "body": "<p>We currently ship within the United States only, including Alaska, Hawaii, and Puerto Rico. We're working on expanding internationally — <a href=\"#pnice_newsletter\">join our email list</a> to be notified when we ship to your country.</p>"
        }},
        { "type": "info_block", "settings": {
          "title": "Lost or damaged packages",
          "body": "<p>If your package arrives damaged, take a photo of the box and contents and email <a href=\"mailto:support@p-nice.com\">support@p-nice.com</a> within 7 days of delivery. We'll send a replacement at no cost. If your package is marked delivered but missing, please wait 48 hours (carriers occasionally update status early), then contact us — we'll work with the carrier on your behalf and make it right.</p>"
        }},
        { "type": "info_block", "settings": {
          "title": "Returns &amp; refunds",
          "body": "<p>P-nice offers a 30-day satisfaction guarantee. If you're not happy with your purchase, see our <a href=\"/policies/refund-policy\">Refund Policy</a> or email <a href=\"mailto:support@p-nice.com\">support@p-nice.com</a> and we'll make it right.</p>"
        }},
        { "type": "info_block", "settings": {
          "title": "Address changes",
          "body": "<p>If you need to change your shipping address, email <a href=\"mailto:support@p-nice.com\">support@p-nice.com</a> within 1 hour of placing your order. Once a package ships we can't redirect it, but you may be able to update delivery instructions directly with the carrier using the link in your tracking email.</p>"
        }}
      ]
    }
  ]
}
{% endschema %}
