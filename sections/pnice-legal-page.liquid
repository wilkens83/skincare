{%- comment -%}
  P-nice Legal/Policy page section.
  Generic content holder — eyebrow + heading + intro + rich-body blocks
  + a "last updated" stamp + the brand contact card at the bottom.

  Used by:
    - page.refund-policy.json
    - page.privacy-policy.json
    - page.terms-of-service.json

  These templates carry default policy copy suitable for a US-based
  D2C cosmetics merchant; the merchant should still publish the
  authoritative policy text in Shopify admin → Settings → Policies
  so the /policies/* URLs also resolve and Shopify checkout displays
  them.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="pnice-legal color-{{ section.settings.color_scheme }}">
  <div class="pnice-wrap pnice-legal__wrap">
    <header class="pnice-legal__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pnice-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="pnice-legal__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.last_updated != blank -%}
        <p class="pnice-legal__meta">Last updated: {{ section.settings.last_updated }}</p>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="pnice-legal__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <div class="pnice-legal__body">
      {%- for block in section.blocks -%}
        <section class="pnice-legal__block" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h2>{{ block.settings.title }}</h2>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="rte">{{ block.settings.body }}</div>
          {%- endif -%}
        </section>
      {%- endfor -%}

      <section class="pnice-legal__contact">
        <h2>Contact us</h2>
        <p>If you have questions about this policy, contact us:</p>
        <ul>
          <li>Email: <a href="mailto:support@p-nice.com">support@p-nice.com</a></li>
          <li>Phone: <a href="tel:+16165201895">616-520-1895</a> (Mon–Fri, 9 am–5 pm ET)</li>
          <li>Mail: P-nice, 3008 Woodbridge Dr SE, Grand Rapids, MI</li>
        </ul>
      </section>
    </div>
  </div>
</section>

{% stylesheet %}
  .pnice-legal {
    font-family: var(--font-body--family);
    padding-block: clamp(40px, 6vw, 80px);
  }
  .pnice-legal__head {
    max-width: 760px;
    margin: 0 auto 36px;
  }
  .pnice-legal__title {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-foreground-heading);
    margin: 12px 0 8px;
  }
  .pnice-legal__meta {
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--color-foreground);
    opacity: 0.65;
    margin-bottom: 18px;
  }
  .pnice-legal__intro {
    color: var(--color-foreground);
    opacity: 0.85;
    font-size: 15.5px;
    line-height: 1.7;
  }
  .pnice-legal__intro p { margin-bottom: 10px; }
  .pnice-legal__body {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .pnice-legal__body h2 {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 24px;
    font-weight: 500;
    color: var(--color-foreground-heading);
    margin-bottom: 10px;
  }
  .pnice-legal__body .rte p { margin-bottom: 10px; line-height: 1.7; font-size: 15px; }
  .pnice-legal__body .rte ul,
  .pnice-legal__body .rte ol { padding-left: 22px; margin-bottom: 12px; }
  .pnice-legal__body .rte li { margin-bottom: 4px; line-height: 1.6; }
  .pnice-legal__body a { color: var(--pnice-sage, #4a6741); text-decoration: underline; }
  .pnice-legal__contact ul { list-style: none; padding: 0; }
  .pnice-legal__contact li { padding: 4px 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Legal Page",
  "tag": "section",
  "class": "section-wrapper pnice-legal-wrapper",
  "max_blocks": 30,
  "blocks": [
    {
      "type": "section",
      "name": "Section",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Section title" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Section content here.</p>" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer Info" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Policy" },
    { "type": "text", "id": "last_updated", "label": "Last updated (e.g. June 1, 2026)" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>This policy explains how we operate.</p>" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "P-nice Legal Page",
      "category": "P-nice"
    }
  ]
}
{% endschema %}
