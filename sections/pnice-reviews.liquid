{%- comment -%} P-nice customer reviews grid {%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="pnice-sec pnice-reviews color-{{ section.settings.color_scheme }}">
  <div class="pnice-wrap">
    <div class="pnice-reviews__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pnice-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pnice-reviews__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pnice-reviews__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="pnice-rev-grid">
      {%- for block in section.blocks -%}
        <div class="pnice-rev" {{ block.shopify_attributes }}>
          <div class="pnice-card__stars">
            {%- for i in (1..5) -%}
              <svg class="pnice-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 2.9 6.3 6.9.8-5.1 4.6 1.4 6.8L12 17.8 5.9 21.3l1.4-6.8L2.2 9.9l6.9-.8z"/></svg>
            {%- endfor -%}
          </div>
          <q class="pnice-rev__q">{{ block.settings.quote }}</q>
          <div class="pnice-rev__who">
            <div class="pnice-rev__av" aria-hidden="true">{{ block.settings.name | slice: 0, 1 }}</div>
            <div>
              <b>{{ block.settings.name }}</b>
              <small>{{ block.settings.meta }}</small>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pnice-reviews__head {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 52px;
  }
  .pnice-reviews__title {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(34px, 4vw, 52px);
    color: var(--color-foreground-heading);
    margin-top: 14px;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .pnice-reviews__sub {
    color: var(--color-foreground);
    opacity: 0.72;
    margin: 14px auto 0;
    max-width: 440px;
    font-size: 15.5px;
    font-family: var(--font-body--family);
    line-height: 1.6;
  }
  .pnice-rev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .pnice-rev {
    background: #fff;
    border: 1px solid var(--pnice-line, #e3dccf);
    border-radius: 5px;
    padding: 34px 30px;
    display: flex;
    flex-direction: column;
    font-family: var(--font-body--family);
  }
  .pnice-rev .pnice-card__stars {
    margin-bottom: 16px;
  }
  .pnice-rev__q {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: 21px;
    line-height: 1.45;
    color: var(--color-foreground-heading);
    display: block;
    flex: 1;
  }
  .pnice-rev__q::before {
    content: "\201C";
  }
  .pnice-rev__q::after {
    content: "\201D";
  }
  .pnice-rev__who {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
  }
  .pnice-rev__av {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--pnice-cream-deep, #ece3d7);
    color: var(--pnice-sage, #4a6741);
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
  }
  .pnice-rev__who b {
    font-size: 14px;
    font-weight: 500;
    display: block;
    color: var(--color-foreground-heading);
  }
  .pnice-rev__who small {
    font-size: 12px;
    color: var(--color-foreground);
    opacity: 0.72;
  }
  @media (max-width: 880px) {
    .pnice-rev-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Reviews",
  "tag": "section",
  "class": "section-wrapper pnice-reviews-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 9,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I wake up looking like I slept ten hours even when I didn't. The Sleep+ cream is genuinely magic." },
        { "type": "text", "id": "name", "label": "Name", "default": "Maya R." },
        { "type": "text", "id": "meta", "label": "Meta", "default": "Verified Buyer · 28 days" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real skin, real results" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by Real Beauty" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Over 10,000 customers report a more luminous, glass-like complexion within 14 days." },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "P-nice Reviews",
      "category": "P-nice",
      "blocks": [
        { "type": "review", "settings": { "quote": "I wake up looking like I slept ten hours even when I didn't. The Sleep+ cream is genuinely magic.", "name": "Maya R.", "meta": "Verified Buyer · 28 days" } },
        { "type": "review", "settings": { "quote": "Finally a retinol that doesn't wreck my sensitive skin. Smoother texture, zero flaking. Obsessed.", "name": "Jordan T.", "meta": "Verified Buyer · 6 weeks" } },
        { "type": "review", "settings": { "quote": "The whole ritual feels luxurious but it's the results that keep me reordering. Glass skin is real.", "name": "Lena K.", "meta": "Verified Buyer · 3 months" } }
      ]
    }
  ]
}
{% endschema %}
