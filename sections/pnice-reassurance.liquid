{%- comment -%} P-nice reassurance bar (shipping / returns / secure) {%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section id="reassurance" class="pnice-reassure color-{{ section.settings.color_scheme }}">
  <div class="pnice-reassure__wrap pnice-wrap">
    {%- for block in section.blocks -%}
      <div class="pnice-reassure__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}
            <svg class="pnice-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h13v8H3zM16 10h3l2 3v2h-5z"/><circle cx="7" cy="17" r="2"/><circle cx="18" cy="17" r="2"/></svg>
          {%- when 'return' -%}
            <svg class="pnice-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0Z"/><path d="M3 12h4l2-5 3 10 2-5h7"/></svg>
          {%- when 'lock' -%}
            <svg class="pnice-ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
          {%- else -%}
            <svg class="pnice-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
        {%- endcase -%}
        <div>
          <b>{{ block.settings.heading }}</b>
          <small>{{ block.settings.subtext }}</small>
        </div>
      </div>
      {%- unless forloop.last -%}
        <div class="pnice-reassure__div" aria-hidden="true"></div>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .pnice-reassure {
    font-family: var(--font-body--family);
  }
  .pnice-reassure__wrap {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    padding-block: 26px;
  }
  .pnice-reassure__item {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
    justify-content: center;
  }
  .pnice-reassure__item .pnice-ic {
    stroke: var(--pnice-gold-soft, #c8a460);
    stroke-width: 1.4;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .pnice-reassure__item b {
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.04em;
    display: block;
    white-space: nowrap;
    color: currentColor;
  }
  .pnice-reassure__item small {
    font-size: 12px;
    opacity: 0.72;
    letter-spacing: 0.03em;
  }
  .pnice-reassure__div {
    width: 1px;
    background: rgba(255, 255, 255, 0.16);
    align-self: stretch;
  }
  @media (max-width: 760px) {
    .pnice-reassure__wrap {
      flex-direction: column;
      gap: 18px;
    }
    .pnice-reassure__div {
      display: none;
    }
    .pnice-reassure__item {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Reassurance Bar",
  "tag": "section",
  "class": "section-wrapper pnice-reassure-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 5,
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free Shipping" },
        { "type": "text", "id": "subtext", "label": "Subtext", "default": "On orders over $60" }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "P-nice Reassurance Bar",
      "category": "P-nice",
      "settings": { "color_scheme": "scheme-5" },
      "blocks": [
        { "type": "feature", "settings": { "icon": "truck", "heading": "Free Shipping", "subtext": "On orders over $60" } },
        { "type": "feature", "settings": { "icon": "return", "heading": "30-Day Returns", "subtext": "Love it or return it" } },
        { "type": "feature", "settings": { "icon": "lock", "heading": "Secure Checkout", "subtext": "100% protected payments" } }
      ]
    }
  ]
}
{% endschema %}
