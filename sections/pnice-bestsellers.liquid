{%- comment -%} P-nice Best Sellers — luxury skincare product row {%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="pnice-sec pnice-bestsellers color-{{ section.settings.color_scheme }}">
  <div class="pnice-wrap">
    <div class="pnice-sec__head">
      <div class="pnice-sec__t">
        {%- if section.settings.eyebrow != blank -%}
          <span class="pnice-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pnice-sec__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="pnice-sec__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.viewall_label != blank -%}
        <a href="{{ section.settings.viewall_link | default: '#' }}" class="pnice-viewall">
          {{ section.settings.viewall_label }}
          <svg class="pnice-ic" style="width:15px;height:15px;" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="pnice-prods">
      {%- assign products_source = section.settings.collection -%}
      {%- if products_source != blank and products_source.products.size > 0 -%}
        {%- for product in products_source.products limit: section.settings.max_products -%}
          {%- render 'pnice-product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- render 'pnice-product-card', block: block -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pnice-bestsellers {
    background: var(--pnice-paper, #faf7f1);
  }
  .pnice-prods {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .pnice-card {
    background: #fff;
    border: 1px solid var(--pnice-line, #e3dccf);
    border-radius: 5px;
    overflow: hidden;
    transition:
      transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .pnice-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 26px 46px -28px rgba(70, 60, 40, 0.4);
  }
  .pnice-card__media {
    position: relative;
    background: #f4f4f2;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .pnice-card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.5s;
  }
  .pnice-card__media img.pnice-card__media-alt {
    opacity: 0;
  }
  .pnice-card:hover .pnice-card__media-alt {
    opacity: 1;
  }
  .pnice-card__tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--pnice-sage, #4a6741);
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 11px;
    border-radius: 30px;
    z-index: 2;
    font-weight: 500;
  }
  .pnice-card__tag--gold {
    background: var(--pnice-gold, #b0893f);
  }
  .pnice-card__body {
    padding: 24px 24px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
    font-family: var(--font-body--family);
  }
  .pnice-card__stars {
    display: flex;
    gap: 2px;
    color: var(--pnice-gold, #b0893f);
    margin-bottom: 10px;
    align-items: center;
  }
  .pnice-card__stars .pnice-ic {
    width: 14px;
    height: 14px;
    fill: var(--pnice-gold, #b0893f);
    stroke: var(--pnice-gold, #b0893f);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pnice-card__stars small {
    color: var(--color-foreground);
    opacity: 0.62;
    font-size: 12px;
    margin-left: 6px;
    letter-spacing: 0.02em;
  }
  .pnice-card h3 {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 24px;
    color: var(--color-foreground-heading);
    line-height: 1.1;
    font-weight: 500;
  }
  .pnice-card__desc {
    font-size: 13.5px;
    color: var(--color-foreground);
    opacity: 0.72;
    margin: 9px 0 18px;
    flex: 1;
    line-height: 1.5;
  }
  .pnice-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .pnice-card__price {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 26px;
    color: var(--pnice-sage, #4a6741);
    font-weight: 500;
  }
  .pnice-card__price s {
    font-size: 16px;
    color: var(--color-foreground);
    opacity: 0.5;
    margin-left: 8px;
  }
  .pnice-card__add {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--pnice-sage, #4a6741);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
    flex-shrink: 0;
    border: 0;
    cursor: pointer;
  }
  .pnice-card__add:hover {
    background: var(--pnice-sage-deep, #3a4d33);
    transform: scale(1.08);
  }
  .pnice-card__add .pnice-ic {
    stroke: #fff;
    width: 20px;
    height: 20px;
    fill: none;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 880px) {
    .pnice-prods {
      grid-template-columns: 1fr;
      max-width: 420px;
      margin: 0 auto;
    }
  }
{% endstylesheet %}

{% schema %}
