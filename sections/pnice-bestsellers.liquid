  "max_blocks": 6,
  "blocks": [
    {
      "type": "static_card",
      "name": "Static product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_alt", "label": "Hover image" },
