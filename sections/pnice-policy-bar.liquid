{%- comment -%}
  P-nice Policy Bar
  ---------------------------------------------------------
  Visible row of links to Contact, Shipping, Refund, Privacy,
  Terms, and (optionally) FAQ. Designed to be added to the
  Footer group so policy access is one click from every page —
  a Stripe / payment-processor compliance basic.

  Auto-falls-back: when a Shopify policy is unpublished it
  links to /policies/<slug> anyway, which Shopify will 404
  cleanly. The merchant publishes policies in
  Settings → Policies and the URLs become live.
{%- endcomment -%}

{%- comment -%}
  Resolve each policy link. Shopify's shop.<policy>.url ALWAYS returns
  a path, even when the policy body is empty — and that path 404s.
  So we check shop.<policy>.body, and if it's blank we fall back to a
  /pages/* URL served from the theme's own page templates.
{%- endcomment -%}
{%- liquid
  if shop.shipping_policy.body != blank
    assign shipping_url = shop.shipping_policy.url
  else
    assign shipping_url = '/pages/shipping'
  endif

  if shop.refund_policy.body != blank
    assign refund_url = shop.refund_policy.url
  else
    assign refund_url = '/pages/refund-policy'
  endif

  if shop.privacy_policy.body != blank
    assign privacy_url = shop.privacy_policy.url
  else
    assign privacy_url = '/pages/privacy-policy'
  endif

  if shop.terms_of_service.body != blank
    assign terms_url = shop.terms_of_service.url
  else
    assign terms_url = '/pages/terms-of-service'
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="pnice-policy-bar color-{{ section.settings.color_scheme }}">
  <div class="pnice-wrap pnice-policy-bar__wrap">
    {%- if section.settings.heading != blank -%}
      <p class="pnice-policy-bar__heading">{{ section.settings.heading }}</p>
    {%- endif -%}
    <ul class="pnice-policy-bar__list" role="list">
      <li><a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a></li>
      <li><a href="{{ shipping_url }}">Shipping</a></li>
      <li><a href="{{ refund_url }}">Returns &amp; Refunds</a></li>
      <li><a href="{{ privacy_url }}">Privacy</a></li>
      <li><a href="{{ terms_url }}">Terms</a></li>
      {%- if section.settings.show_faq -%}
        <li><a href="{{ pages.faq.url | default: '/pages/faq' }}">FAQ</a></li>
      {%- endif -%}
      {%- if section.settings.show_accessibility and shop.legal_notice_url != blank -%}
        <li><a href="{{ shop.legal_notice_url }}">Legal Notice</a></li>
      {%- endif -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .pnice-policy-bar {
    font-family: var(--font-body--family);
    padding-block: 18px;
    border-top: 1px solid var(--pnice-line, #e3dccf);
  }
  .pnice-policy-bar__wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .pnice-policy-bar__heading {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pnice-gold, #b0893f);
    margin: 0 8px 0 0;
    font-weight: 500;
  }
  .pnice-policy-bar__list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
    gap: 10px 22px;
    justify-content: center;
  }
  .pnice-policy-bar__list a {
    color: var(--color-foreground);
    font-size: 13px;
    text-decoration: none;
    transition: color 0.2s, text-decoration-color 0.2s;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
  }
  .pnice-policy-bar__list a:hover {
    color: var(--pnice-sage, #4a6741);
    text-decoration-color: currentColor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Policy Bar",
  "tag": "section",
  "class": "section-wrapper pnice-policy-bar-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)", "default": "Customer Info" },
    { "type": "checkbox", "id": "show_faq", "label": "Show FAQ link", "default": true },
    { "type": "checkbox", "id": "show_accessibility", "label": "Show Legal Notice link (if set in Settings)", "default": false },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "P-nice Policy Bar",
      "category": "P-nice"
    }
  ]
}
{% endschema %}
