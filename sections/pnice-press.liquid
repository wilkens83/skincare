{%- comment -%}
  P-nice "As Seen In" press logo strip.

  Renders a row of muted, monochrome press / publication logos.
  Each block has an image picker (image_picker) and a link.
  If a block has no image, the block's text is rendered as a
  serif wordmark so the strip is never empty.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section id="press" class="pnice-press color-{{ section.settings.color_scheme }}">
  <div class="pnice-wrap pnice-press__wrap">
    {%- if section.settings.heading != blank -%}
      <p class="pnice-press__heading">{{ section.settings.heading }}</p>
    {%- endif -%}
    <ul class="pnice-press__list" role="list">
      {%- for block in section.blocks -%}
        <li class="pnice-press__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" rel="noopener" target="_blank" aria-label="{{ block.settings.name }}">
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 320 | image_tag:
              widths: '160, 240, 320',
              loading: 'lazy',
              alt: block.settings.name,
              class: 'pnice-press__logo'
            }}
          {%- else -%}
            <span class="pnice-press__wordmark">{{ block.settings.name }}</span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .pnice-press {
    font-family: var(--font-body--family);
    padding-block: clamp(36px, 4vw, 56px);
    border-block: 1px solid var(--pnice-line, #e3dccf);
  }
  .pnice-press__heading {
    font-size: 11.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--pnice-gold, #b0893f);
    text-align: center;
    margin-bottom: 28px;
    font-weight: 500;
  }
  .pnice-press__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 28px 56px;
  }
  .pnice-press__item {
    opacity: 0.72;
    transition: opacity 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
  }
  .pnice-press__item:hover { opacity: 1; }
  .pnice-press__item a {
    display: inline-flex;
    align-items: center;
    height: 100%;
  }
  .pnice-press__logo {
    max-height: 28px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
  }
  .pnice-press__wordmark {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
    line-height: 1;
  }
  @media (max-width: 540px) {
    .pnice-press__list { gap: 18px 32px; }
    .pnice-press__wordmark { font-size: 18px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Press Strip",
  "tag": "section",
  "class": "section-wrapper pnice-press-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 12,
  "blocks": [
    {
      "type": "logo",
      "name": "Press logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Publication name", "default": "Vogue" },
        { "type": "image_picker", "id": "image", "label": "Logo image (optional)" },
        { "type": "url", "id": "link", "label": "Article URL (optional)" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As Seen In" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "P-nice Press Strip",
      "category": "P-nice",
      "blocks": [
        { "type": "logo", "settings": { "name": "Vogue" } },
        { "type": "logo", "settings": { "name": "Allure" } },
        { "type": "logo", "settings": { "name": "Byrdie" } },
        { "type": "logo", "settings": { "name": "Harper's Bazaar" } },
        { "type": "logo", "settings": { "name": "InStyle" } }
      ]
    }
  ]
}
{% endschema %}
