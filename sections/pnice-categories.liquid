{%- comment -%} P-nice Shop by Category grid {%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="pnice-sec color-{{ section.settings.color_scheme }}">
  <div class="pnice-wrap">
    <div class="pnice-sec__head">
      <div class="pnice-sec__t">
        {%- if section.settings.eyebrow != blank -%}
          <span class="pnice-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pnice-sec__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="pnice-sec__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.viewall_label != blank -%}
        <a href="{{ section.settings.viewall_link | default: '#' }}" class="pnice-viewall">
          {{ section.settings.viewall_label }}
          <svg class="pnice-ic" style="width:15px;height:15px;" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="pnice-cats">
      {%- for block in section.blocks -%}
        {%- assign tile_class = 'pnice-cat' -%}
        {%- if block.settings.coming_soon -%}
          {%- assign tile_class = tile_class | append: ' pnice-cat--soon pnice-cat--s' | append: forloop.index -%}
        {%- endif -%}
        {%- if block.settings.coming_soon -%}
          <div class="{{ tile_class }}" {{ block.shopify_attributes }}>
            <span class="pnice-cat__tag">Coming Soon</span>
            <div class="pnice-cat__body">
              <h3>{{ block.settings.title }}</h3>
              <span class="pnice-cat__shop">
                {{ block.settings.cta | default: 'Notify Me' }}
                <svg class="pnice-ic" style="width:14px;height:14px;" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </div>
        {%- else -%}
          <a href="{{ block.settings.link | default: '#' }}" class="{{ tile_class }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                widths: '300, 500, 800',
                sizes: '(min-width: 900px) 25vw, 50vw',
                loading: 'lazy',
                alt: block.settings.image.alt | default: block.settings.title
              }}
            {%- elsif block.settings.fallback_asset != blank -%}
              <img
                src="{{ block.settings.fallback_asset | asset_url }}"
                alt="{{ block.settings.title }}"
                loading="lazy"
                width="800"
                height="1067"
              >
            {%- endif -%}
            <div class="pnice-cat__veil" aria-hidden="true"></div>
            <div class="pnice-cat__body">
              <h3>{{ block.settings.title }}</h3>
              <span class="pnice-cat__shop">
                {{ block.settings.cta | default: 'Shop Now' }}
                <svg class="pnice-ic" style="width:14px;height:14px;stroke:#fff;" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pnice-sec {
    padding-block: 104px;
    font-family: var(--font-body--family);
  }
  .pnice-sec__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 52px;
    gap: 20px;
  }
  .pnice-sec__title {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(34px, 4vw, 52px);
    color: var(--color-foreground-heading);
    margin-top: 14px;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .pnice-sec__sub {
    color: var(--color-foreground);
    opacity: 0.72;
    margin-top: 14px;
    max-width: 440px;
    font-size: 15.5px;
    line-height: 1.6;
  }
  .pnice-viewall {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pnice-sage, #4a6741);
    display: inline-flex;
    gap: 8px;
    align-items: center;
    white-space: nowrap;
    transition: gap 0.25s;
    text-decoration: none;
  }
  .pnice-viewall:hover {
    gap: 14px;
  }
  .pnice-cats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .pnice-cat {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--pnice-cream-deep, #ece3d7);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-decoration: none;
    color: inherit;
  }
  .pnice-cat img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .pnice-cat:hover img {
    transform: scale(1.06);
  }
  .pnice-cat__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(44, 46, 41, 0) 38%, rgba(44, 46, 41, 0.62) 100%);
  }
  .pnice-cat__body {
    position: relative;
    padding: 26px;
    color: #fff;
  }
  .pnice-cat__body h3 {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 25px;
    color: #fff;
    font-weight: 500;
    line-height: 1.1;
  }
  .pnice-cat__shop {
    font-family: var(--font-body--family);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: 8px;
    display: inline-flex;
    gap: 7px;
    align-items: center;
    opacity: 0.9;
    transition: gap 0.25s;
  }
  .pnice-cat:hover .pnice-cat__shop {
    gap: 13px;
  }
  .pnice-cat--soon {
    background: linear-gradient(150deg, #e7ddcd, #d9cdb7);
  }
  .pnice-cat--soon.pnice-cat--s2 {
    background: linear-gradient(150deg, #e7ddcd, #d9cdb7);
  }
  .pnice-cat--soon.pnice-cat--s3 {
    background: linear-gradient(150deg, #dfe4d6, #c9d3bd);
  }
  .pnice-cat--soon.pnice-cat--s4 {
    background: linear-gradient(150deg, #ece2d4, #e0cdba);
  }
  .pnice-cat--soon .pnice-cat__body {
    color: var(--color-foreground);
  }
  .pnice-cat--soon .pnice-cat__body h3 {
    color: var(--pnice-sage-deep, #3a4d33);
  }
  .pnice-cat--soon .pnice-cat__veil {
    display: none;
  }
  .pnice-cat__tag {
    position: absolute;
    top: 18px;
    left: 18px;
    background: rgba(255, 255, 255, 0.78);
    color: var(--pnice-sage-deep, #3a4d33);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 6px 11px;
    border-radius: 30px;
    font-weight: 500;
  }
  .pnice-cat--soon .pnice-cat__shop {
    opacity: 0.65;
    color: var(--color-foreground);
  }
  @media (max-width: 900px) {
    .pnice-cats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .pnice-sec {
      padding-block: 72px;
    }
    .pnice-sec__head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 520px) {
    .pnice-cats {
      grid-template-columns: 1fr;
    }
    .pnice-cat {
      aspect-ratio: 16 / 10;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Categories",
  "tag": "section",
  "class": "section-wrapper pnice-categories-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename (e.g. pnice-serum-open.jpg)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Skincare" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "cta", "label": "CTA", "default": "Shop Now" },
        { "type": "checkbox", "id": "coming_soon", "label": "Coming soon", "default": false }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Thoughtfully formulated collections for every step of your routine — from overnight repair to everyday glow." },
    { "type": "text", "id": "viewall_label", "label": "View all label", "default": "View All Products" },
    { "type": "url", "id": "viewall_link", "label": "View all link" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "P-nice Categories",
      "category": "P-nice",
      "blocks": [
        { "type": "category", "settings": { "title": "Skincare", "cta": "Shop Now", "fallback_asset": "pnice-serum-open.jpg" } },
        { "type": "category", "settings": { "title": "Haircare", "coming_soon": true, "cta": "Notify Me" } },
        { "type": "category", "settings": { "title": "Body Care", "coming_soon": true, "cta": "Notify Me" } },
        { "type": "category", "settings": { "title": "Makeup", "coming_soon": true, "cta": "Notify Me" } }
      ]
    }
  ]
}
{% endschema %}
