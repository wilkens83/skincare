{%- comment -%} P-nice loyalty / rewards section {%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="pnice-sec pnice-loyalty color-{{ section.settings.color_scheme }}">
  <div class="pnice-wrap pnice-loyalty__wrap">
    <div class="pnice-loy-card">
      <div class="pnice-loy-card__ring" aria-hidden="true"></div>
      <div class="pnice-loy-card__ring pnice-loy-card__ring--r2" aria-hidden="true"></div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="pnice-eyebrow pnice-eyebrow--gold">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pnice-loy-card__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="pnice-loy-card__body">{{ section.settings.body }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="pnice-btn pnice-btn--cream">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="pnice-loy-cols">
      {%- for block in section.blocks -%}
        <div class="pnice-loy-col" {{ block.shopify_attributes }}>
          <div class="pnice-loy-col__num" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'dollar' -%}
                <svg class="pnice-ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 9.5h4a1.5 1.5 0 0 1 0 3H9.5h3.5a1.5 1.5 0 0 1 0 3H9"/></svg>
              {%- when 'gift' -%}
                <svg class="pnice-ic" viewBox="0 0 24 24"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7S10 2 7.5 3.5 9 7 12 7Zm0 0s2-5 4.5-3.5S15 7 12 7Z"/></svg>
              {%- when 'star' -%}
                <svg class="pnice-ic" viewBox="0 0 24 24"><path d="m12 2 2.9 6.3 6.9.8-5.1 4.6 1.4 6.8L12 17.8 5.9 21.3l1.4-6.8L2.2 9.9l6.9-.8z"/></svg>
              {%- else -%}
                <svg class="pnice-ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/></svg>
            {%- endcase -%}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pnice-loyalty {
    background: var(--pnice-cream, #f5f0ea);
  }
  .pnice-loyalty__wrap {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 50px;
    align-items: center;
  }
  .pnice-loy-card {
    background: var(--pnice-sage, #4a6741);
    color: #f1ede4;
    border-radius: 6px;
    padding: 54px 46px;
    position: relative;
    overflow: hidden;
  }
  .pnice-eyebrow--gold {
    color: var(--pnice-gold-soft, #c8a460);
  }
  .pnice-loy-card__title {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(32px, 3.4vw, 46px);
    color: #fff;
    margin: 16px 0 18px;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .pnice-loy-card__body {
    color: #cdd6c5;
    font-size: 15px;
    margin-bottom: 32px;
    max-width: 330px;
    line-height: 1.6;
  }
  .pnice-btn--cream {
    background: #f1ede4;
    color: var(--pnice-sage-deep, #3a4d33);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--font-body--family);
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 17px 36px;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
    text-decoration: none;
    border: 0;
    cursor: pointer;
  }
  .pnice-btn--cream:hover {
    background: #fff;
    transform: translateY(-2px);
  }
  .pnice-loy-card__ring {
    position: absolute;
    width: 230px;
    height: 230px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    right: -70px;
    top: -70px;
  }
  .pnice-loy-card__ring--r2 {
    width: 150px;
    height: 150px;
    right: -30px;
    top: -30px;
  }
  .pnice-loy-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .pnice-loy-col__num {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--pnice-sage, #4a6741);
    color: var(--pnice-sage, #4a6741);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .pnice-loy-col__num .pnice-ic {
    stroke: var(--pnice-sage, #4a6741);
    stroke-width: 1.4;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    width: 22px;
    height: 22px;
  }
  .pnice-loy-col h3 {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 21px;
    margin-bottom: 8px;
    color: var(--color-foreground-heading);
    font-weight: 500;
    line-height: 1.1;
  }
  .pnice-loy-col p {
    font-family: var(--font-body--family);
    font-size: 14px;
    color: var(--color-foreground);
    opacity: 0.78;
    line-height: 1.6;
  }
  @media (max-width: 880px) {
    .pnice-loyalty__wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .pnice-loy-cols {
      gap: 24px;
    }
  }
  @media (max-width: 560px) {
    .pnice-loy-cols {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Loyalty",
  "tag": "section",
  "class": "section-wrapper pnice-loyalty-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 3,
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "dollar", "label": "Dollar" },
            { "value": "gift", "label": "Gift" },
            { "value": "star", "label": "Star" }
          ],
          "default": "dollar"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Earn Points" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Collect 5 points for every dollar spent across the shop." }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "P-nice Rewards" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good choices deserve rewards." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Join free and earn on every order — plus members-only gifts, early access, and birthday treats." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Join the Club" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "P-nice Loyalty",
      "category": "P-nice",
      "blocks": [
        { "type": "perk", "settings": { "icon": "dollar", "title": "Earn Points", "body": "Collect 5 points for every dollar spent across the shop." } },
        { "type": "perk", "settings": { "icon": "gift", "title": "Unlock Rewards", "body": "Redeem points for exclusive discounts and seasonal gifts." } },
        { "type": "perk", "settings": { "icon": "star", "title": "VIP Access", "body": "Be first in line for new drops and limited launches." } }
      ]
    }
  ]
}
{% endschema %}
