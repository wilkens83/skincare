{%- comment -%} P-nice luxury skincare hero {%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="pnice-hero color-{{ section.settings.color_scheme }}" style="--pnice-hero-bg-start: {{ section.settings.bg_start }}; --pnice-hero-bg-end: {{ section.settings.bg_end }};">
  <div class="pnice-hero__wrap pnice-wrap">
    <div class="pnice-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pnice-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="pnice-hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pnice-hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="pnice-hero__ctas">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link | default: '#' }}" class="pnice-btn pnice-btn--primary">
            {{ section.settings.primary_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '#' }}" class="pnice-btn-link">
            {{ section.settings.secondary_label }}
            <svg class="pnice-ic" style="width:16px;height:16px;" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="pnice-hero__badges">
          {%- for block in section.blocks -%}
            {%- if block.type == 'hero_badge' -%}
              <div class="pnice-hbadge" {{ block.shopify_attributes }}>
                {%- case block.settings.icon -%}
                  {%- when 'leaf' -%}
                    <svg class="pnice-ic" viewBox="0 0 24 24"><path d="M12 2c3 4 7 5 7 10a7 7 0 0 1-14 0c0-5 4-6 7-10Z"/></svg>
                  {%- when 'check' -%}
                    <svg class="pnice-ic" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                  {%- when 'shield' -%}
                    <svg class="pnice-ic" viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"/></svg>
                  {%- when 'recycle' -%}
                    <svg class="pnice-ic" viewBox="0 0 24 24"><path d="M3 12a9 9 0 0 1 9-9c4 0 6 2 6 2M21 12a9 9 0 0 1-9 9c-4 0-6-2-6-2M16 4h3V1M8 20H5v3"/></svg>
                  {%- else -%}
                    <svg class="pnice-ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/></svg>
                {%- endcase -%}
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pnice-hero__art">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1120 | image_tag:
          class: 'pnice-hero__image',
          alt: section.settings.hero_image.alt | default: section.settings.heading,
          widths: '400, 600, 800, 1120',
          sizes: '(min-width: 900px) 50vw, 100vw',
          loading: 'eager',
          fetchpriority: 'high'
        }}
      {%- else -%}
        <img
          class="pnice-hero__image"
          src="{{ 'pnice-hero-bundle.jpg' | asset_url }}"
          alt="P-nice skincare collection"
          loading="eager"
          fetchpriority="high"
          width="1120"
          height="1120"
        >
      {%- endif -%}

      {%- if section.settings.show_stamp -%}
        <div class="pnice-hero__stamp">
          <b>{{ section.settings.stamp_brand | default: 'P-nice' }}</b>
          {{ section.settings.stamp_text | default: 'since 2026' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pnice-hero {
    background: linear-gradient(180deg, var(--pnice-hero-bg-start, #f5f0ea) 0%, var(--pnice-hero-bg-end, #f1ebe1) 100%);
    position: relative;
    overflow: hidden;
  }
  .pnice-hero__wrap {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 40px;
    align-items: center;
    min-height: 660px;
    padding-block: 60px;
  }
  .pnice-hero__copy {
    max-width: 520px;
  }
  .pnice-eyebrow {
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--pnice-gold, #b0893f);
    display: inline-block;
  }
  .pnice-hero__title {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(48px, 5.6vw, 84px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 22px 0 0;
    color: var(--color-foreground-heading);
    font-weight: 500;
  }
  .pnice-hero__title em,
  .pnice-hero__title i {
    font-style: italic;
    color: var(--pnice-sage, #4a6741);
  }
  .pnice-hero__sub {
    font-size: 18px;
    color: var(--color-foreground);
    opacity: 0.78;
    margin: 24px 0 36px;
    max-width: 440px;
    line-height: 1.7;
  }
  .pnice-hero__ctas {
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
  }
  .pnice-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--font-body--family);
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 17px 36px;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
    text-decoration: none;
    border: 0;
    cursor: pointer;
  }
  .pnice-btn--primary {
    background: var(--pnice-sage, #4a6741);
    color: #fff;
  }
  .pnice-btn--primary:hover {
    background: var(--pnice-sage-deep, #3a4d33);
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -12px rgba(58, 77, 51, 0.55);
  }
  .pnice-btn-link {
    font-family: var(--font-body--family);
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    transition: gap 0.25s, color 0.25s;
    white-space: nowrap;
    text-decoration: none;
  }
  .pnice-btn-link:hover {
    color: var(--pnice-sage, #4a6741);
    gap: 14px;
  }
  .pnice-hero__badges {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 26px;
    margin-top: 54px;
    max-width: 460px;
  }
  .pnice-hbadge {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--color-foreground);
    opacity: 0.85;
    letter-spacing: 0.01em;
  }
  .pnice-hbadge .pnice-ic {
    width: 20px;
    height: 20px;
    stroke: var(--pnice-sage, #4a6741);
    flex-shrink: 0;
  }
  .pnice-ic {
    stroke: currentColor;
    stroke-width: 1.4;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pnice-hero__art {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .pnice-hero__image {
    width: 100%;
    max-width: 560px;
    border-radius: 4px;
    filter: drop-shadow(0 40px 60px rgba(90, 70, 40, 0.18));
    mix-blend-mode: multiply;
    display: block;
    height: auto;
  }
  .pnice-hero__placeholder {
    width: 100%;
    max-width: 560px;
  }
  .pnice-hero__stamp {
    position: absolute;
    left: -6px;
    bottom: 34px;
    width: 118px;
    height: 118px;
    border-radius: 50%;
    background: var(--pnice-sage, #4a6741);
    color: #f1ede4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-body--family);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.5;
    transform: rotate(-8deg);
    box-shadow: 0 12px 26px -10px rgba(58, 77, 51, 0.6);
  }
  .pnice-hero__stamp b {
    font-family: var(--pnice-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 30px;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    display: block;
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .pnice-hero__wrap {
      grid-template-columns: 1fr;
      text-align: center;
      min-height: auto;
      gap: 10px;
    }
    .pnice-hero__copy {
      max-width: none;
      margin: 0 auto;
    }
    .pnice-hero__ctas,
    .pnice-hero__badges {
      justify-content: center;
    }
    .pnice-hero__badges {
      margin-left: auto;
      margin-right: auto;
      text-align: left;
    }
    .pnice-hero__art {
      order: 2;
      margin-top: 30px;
    }
    .pnice-hero__image {
      max-width: 400px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P-nice Hero",
  "tag": "section",
  "class": "section-wrapper pnice-hero-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "hero_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "check", "label": "Check" },
            { "value": "shield", "label": "Shield" },
            { "value": "recycle", "label": "Recycle" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Clean Ingredients"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wellness From Within"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Good for your skin.<br><em>Better</em> for you.</p>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clean, clinically-considered skincare made with bio-identical actives and soothing botanicals — formulated to work with your skin, never against it."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link label",
      "default": "Explore Ingredients"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Stamp"
    },
    {
      "type": "checkbox",
      "id": "show_stamp",
      "label": "Show stamp",
      "default": true
    },
    {
      "type": "text",
      "id": "stamp_brand",
      "label": "Stamp brand",
      "default": "P-nice"
    },
    {
      "type": "text",
      "id": "stamp_text",
      "label": "Stamp text",
      "default": "since 2026"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_start",
      "label": "Background top",
      "default": "#f5f0ea"
    },
    {
      "type": "color",
      "id": "bg_end",
      "label": "Background bottom",
      "default": "#f1ebe1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "P-nice Hero",
      "category": "P-nice",
      "blocks": [
        { "type": "hero_badge", "settings": { "icon": "leaf", "label": "Clean Ingredients" } },
        { "type": "hero_badge", "settings": { "icon": "check", "label": "Visible Results" } },
        { "type": "hero_badge", "settings": { "icon": "shield", "label": "Safe for Sensitive Skin" } },
        { "type": "hero_badge", "settings": { "icon": "recycle", "label": "Sustainable Packaging" } }
      ]
    }
  ]
}
{% endschema %}
